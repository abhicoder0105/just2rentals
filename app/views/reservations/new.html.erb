<main class="page-shell narrow">
  <section class="page-heading">
    <p class="eyebrow">Reserve <%= @vehicle.name %></p>
    <h1>Complete your booking details.</h1>
    <p class="muted">Step 1 of 3: trip details. Your deposit, documents, and final approval are tracked after confirmation.</p>
  </section>

  <section class="split">
    <article class="vehicle-card sticky-card">
      <div class="vehicle-image" style="background-image: linear-gradient(135deg, <%= @vehicle.hero_color %>99, #11182755), url('<%= @vehicle.image_url %>')"></div>
      <div class="vehicle-card-body">
        <h3><%= @vehicle.name %></h3>
        <p><%= @vehicle.location %> pickup - <%= @vehicle.category %> - <%= @vehicle.seats %> seats</p>
        <strong>Rs. <%= number_with_delimiter(@vehicle.daily_rate.to_i) %>/day</strong>
      </div>
    </article>

    <%= render "form", vehicle: @vehicle, reservation: @reservation %>
  </section>
</main>
